---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const {
  title = 'Kodek — AI & Technology Research',
  description = 'Kodek creates intelligent software, immersive AR/VR experiences, physics-based simulations, and interactive games for industries that demand more from technology.',
  ogImage = 'https://kodek.in/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://kodek.in').href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Kodek",
  "legalName": "Kodekaromas Technologies Pvt. Ltd.",
  "url": "https://kodek.in",
  "logo": {
    "@type": "ImageObject",
    "url": "https://kodek.in/uploads/logo-1777571254206.jpeg"
  },
  "description": "AI and technology research company building intelligent software, AR/VR experiences, physics-based simulations, and interactive games.",
  "email": "sales@kodek.in",
  "areaServed": "Worldwide",
  "foundingLocation": {
    "@type": "Place",
    "addressCountry": "IN"
  },
  "sameAs": [
    "https://github.com/Kodekaromas-Technologies-Pvt-Ltd",
    "https://www.linkedin.com/company/kodekaromas-technologies-private-limited/",
    "https://www.instagram.com/kodekaromas"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Kodek",
  "url": "https://kodek.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://kodek.in/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#06070b">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<link rel="sitemap" href="/sitemap.xml">
<link rel="icon" type="image/jpeg" href="/uploads/logo-1777571254206.jpeg">

<!-- Open Graph -->
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:site_name" content="Kodek">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_IN">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

<!-- JSON-LD: Organization (global) -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<!-- JSON-LD: WebSite + SearchAction -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  /* ---------- TOKENS ---------- */
  :root {
    --bg:        #06070b;
    --bg-1:      #0a0b10;
    --bg-2:      #0f1016;
    --bg-3:      #14161e;
    --text:      #f3f1ec;
    --text-2:    #b9b7c3;
    --text-3:    #7d7c8a;
    --line:      rgba(255,255,255,0.07);
    --line-2:    rgba(255,255,255,0.13);
    --line-3:    rgba(255,255,255,0.22);
    --accent:        oklch(66% 0.17 274);
    --accent-soft:   oklch(66% 0.17 274 / 0.12);
    --accent-line:   oklch(66% 0.17 274 / 0.35);
    --accent-2:      oklch(74% 0.10 220);
    --gutter: clamp(20px, 4vw, 48px);
    --section-y: clamp(64px, 9vw, 112px);
    --container: 1200px;
    --r-sm: 6px;
    --r-md: 10px;
    --r-lg: 14px;
    --shadow-1: 0 1px 0 rgba(255,255,255,0.04) inset, 0 1px 2px rgba(0,0,0,0.4);
    --shadow-2: 0 24px 48px -24px rgba(0,0,0,0.6);
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --t-fast: 160ms;
    --t-med:  240ms;
  }

  /* ---------- RESET ---------- */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: clamp(15px, 1.05vw, 16px);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }
  img, svg, canvas { display: block; max-width: 100%; }
  a { color: inherit; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  input, select, textarea { font: inherit; color: inherit; }
  h1, h2, h3, h4, h5 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p { text-wrap: pretty; }
  ::selection { background: var(--accent-soft); color: var(--text); }

  /* ---------- LAYOUT HELPERS ---------- */
  .container { max-width: var(--container); margin: 0 auto; padding-inline: var(--gutter); }
  section { padding-block: var(--section-y); padding-inline: var(--gutter); }
  section > .container { padding-inline: 0; }

  .eyebrow {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--accent);
  }
  .geo-line {
    width: 32px; height: 2px;
    background: var(--accent);
    border-radius: 1px;
    margin: 14px 0 18px;
    opacity: 0.8;
  }
  .section-title {
    font-size: clamp(28px, 4.2vw, 46px);
    line-height: 1.1; margin-bottom: 16px;
  }
  .section-sub {
    font-size: clamp(15px, 1.3vw, 17px);
    color: var(--text-2); max-width: 60ch;
    line-height: 1.65; font-weight: 400;
  }
  .section-header { margin-bottom: clamp(40px, 5vw, 64px); max-width: 720px; }

  /* ---------- BUTTONS ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 22px; border-radius: var(--r-sm);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px; font-weight: 600; letter-spacing: 0.01em;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
    white-space: nowrap; line-height: 1;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-primary:hover { background: oklch(60% 0.17 274); border-color: oklch(60% 0.17 274); }
  .btn-ghost { background: transparent; color: var(--text); border-color: var(--line-2); }
  .btn-ghost:hover { border-color: var(--line-3); background: rgba(255,255,255,0.03); }
  .btn-lg { padding: 14px 26px; font-size: 15px; }

  /* ---------- HEADER / NAV ---------- */
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: rgba(6,7,11,0.72);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-med) var(--ease), background var(--t-med) var(--ease);
    overflow: hidden;
  }
  .site-header.is-scrolled {
    background: rgba(6,7,11,0.9);
    border-bottom-color: var(--line);
  }
  .nav {
    max-width: var(--container); margin: 0 auto;
    padding-inline: var(--gutter);
    height: 64px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; color: var(--text);
    min-width: 0; flex-shrink: 0;
  }
  .brand-mark {
    width: 30px; height: 30px; border-radius: 50%;
    overflow: hidden; flex: 0 0 auto;
  }
  .brand-mark img { width: 100%; height: 100%; object-fit: cover; }
  .brand-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 15px; letter-spacing: 0.16em;
    white-space: nowrap;
  }
  .nav-links {
    display: flex; align-items: center; gap: 28px; list-style: none;
  }
  .nav-links a {
    color: var(--text-2); text-decoration: none;
    font-size: 13.5px; font-weight: 500;
    transition: color var(--t-fast) var(--ease);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-right { display: flex; align-items: center; gap: 12px; }
  .nav-cta { padding: 9px 18px; font-size: 13px; }
  .nav-toggle {
    display: none; width: 44px; height: 44px;
    align-items: center; justify-content: center;
    border-radius: var(--r-sm); border: 1px solid var(--line);
    background: transparent; flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-toggle span {
    position: relative; width: 18px; height: 1.5px;
    background: var(--text); border-radius: 2px;
    transition: transform var(--t-med) var(--ease), opacity var(--t-fast) var(--ease);
  }
  .nav-toggle span::before, .nav-toggle span::after {
    content: ''; position: absolute; left: 0;
    width: 18px; height: 1.5px; background: var(--text); border-radius: 2px;
    transition: transform var(--t-med) var(--ease), top var(--t-fast) var(--ease);
  }
  .nav-toggle span::before { top: -6px; }
  .nav-toggle span::after  { top:  6px; }
  .nav.is-open .nav-toggle span { background: transparent; }
  .nav.is-open .nav-toggle span::before { top: 0; transform: rotate(45deg); }
  .nav.is-open .nav-toggle span::after  { top: 0; transform: rotate(-45deg); }

  .mobile-panel {
    position: fixed; inset: 64px 0 0 0; z-index: 49;
    background: rgba(6,7,11,0.98); backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    padding: 24px var(--gutter) 36px;
    display: none; overflow-y: auto;
  }
  .nav.is-open + .mobile-panel { display: block; }
  .mobile-panel ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .mobile-panel a {
    display: block; padding: 14px 12px; border-radius: var(--r-sm);
    text-decoration: none; color: var(--text);
    font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 500;
    border: 1px solid transparent;
    transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .mobile-panel a:hover { background: var(--bg-2); border-color: var(--line); }
  .mobile-panel .btn { margin-top: 16px; width: 100%; justify-content: center; }

  /* ---------- SCROLL ANIMATIONS ---------- */
  .fade-up {
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    will-change: opacity, transform;
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  /* ---------- SCROLLBAR ---------- */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--line-3); }

  /* ---------- FOOTER ---------- */
  footer {
    background: var(--bg); border-top: 1px solid var(--line);
    padding: clamp(36px, 5vw, 56px) var(--gutter);
  }
  .footer-inner {
    max-width: var(--container); margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 2fr);
    gap: clamp(28px, 4vw, 56px); align-items: start;
  }
  .footer-brand-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .footer-copy { font-size: 12.5px; color: var(--text-3); line-height: 1.7; max-width: 36ch; }
  .footer-cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 24px;
  }
  .footer-col-head {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-3); margin-bottom: 12px;
  }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .footer-col a { font-size: 13px; color: var(--text-2); text-decoration: none; transition: color var(--t-fast) var(--ease); }
  .footer-col a:hover { color: var(--text); }
  .footer-bottom {
    max-width: var(--container);
    margin: clamp(28px, 4vw, 40px) auto 0;
    padding-top: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--line);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
    font-size: 12px; color: var(--text-3);
  }

  /* ---------- CHATBOT ---------- */
  #chat-btn {
    position: fixed; bottom: 28px; right: 28px; z-index: 200;
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--accent); border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 24px oklch(66% 0.17 274 / 0.4);
    transition: transform 0.2s, opacity 0.2s;
  }
  #chat-btn:hover { transform: scale(1.08); opacity: 0.92; }
  #chat-btn svg { width: 22px; height: 22px; fill: #fff; }
  #chat-panel {
    position: fixed; bottom: 92px; right: 28px; z-index: 200;
    width: 360px; max-height: 520px;
    background: var(--bg-1); border: 1px solid var(--line-2);
    border-radius: var(--r-lg); overflow: hidden;
    display: none; flex-direction: column;
    box-shadow: 0 8px 40px rgba(0,0,0,0.5);
  }
  #chat-panel.open { display: flex; }
  .chat-header {
    padding: 16px 20px;
    background: var(--bg-2); border-bottom: 1px solid var(--line);
    display: flex; align-items: center; gap: 12px;
  }
  .chat-avatar { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
  .chat-avatar img { width: 36px; height: 36px; object-fit: cover; }
  .chat-header-info { flex: 1; }
  .chat-header-name { font-family: 'Space Grotesk', sans-serif; font-size: 14px; font-weight: 600; }
  .chat-header-sub { font-size: 11.5px; color: var(--text-3); }
  .chat-close { background: none; border: none; color: var(--text-3); cursor: pointer; font-size: 20px; line-height: 1; padding: 4px; transition: color 0.2s; }
  .chat-close:hover { color: var(--text); }
  .chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; scroll-behavior: smooth; }
  .chat-msg { max-width: 85%; }
  .chat-msg.bot { align-self: flex-start; }
  .chat-msg.user { align-self: flex-end; }
  .chat-bubble { padding: 10px 14px; border-radius: 12px; font-size: 13.5px; line-height: 1.55; }
  .bot .chat-bubble { background: var(--bg-3); border: 1px solid var(--line); border-radius: 4px 12px 12px 12px; }
  .user .chat-bubble { background: var(--accent); color: #fff; border-radius: 12px 4px 12px 12px; }
  .chat-typing { display: flex; gap: 4px; align-items: center; padding: 10px 14px; background: var(--bg-3); border: 1px solid var(--line); border-radius: 4px 12px 12px 12px; width: fit-content; }
  .chat-typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--text-3); animation: typingDot 1.2s infinite; }
  .chat-typing span:nth-child(2) { animation-delay: 0.2s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typingDot { 0%,60%,100% { opacity: 0.3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
  .chat-input-row { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--line); background: var(--bg-2); }
  #chat-input {
    flex: 1; background: var(--bg-1); border: 1px solid var(--line); border-radius: 8px;
    padding: 10px 14px; color: var(--text); font-family: 'Inter', sans-serif; font-size: 13.5px;
    outline: none; resize: none; transition: border-color 0.2s;
  }
  #chat-input:focus { border-color: var(--accent-line); }
  #chat-input::placeholder { color: var(--text-3); opacity: 0.7; }
  #chat-send {
    background: var(--accent); border: none; border-radius: 8px;
    width: 38px; height: 38px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: opacity 0.2s; flex-shrink: 0;
  }
  #chat-send:hover { opacity: 0.88; }
  #chat-send svg { width: 15px; height: 15px; fill: #fff; }
  #chat-send:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ---------- BREAKPOINTS ---------- */
  @media (max-width: 1024px) {
    .nav-links { display: none; }
    .nav-toggle { display: inline-flex; }
    .nav-cta { display: none; }
  }
  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr; }
    #chat-panel {
      width: calc(100vw - 32px); right: 16px; bottom: 80px;
      max-height: min(520px, calc(100dvh - 110px));
    }
    #chat-btn { right: 20px; bottom: 20px; }
  }
  @media (max-width: 480px) {
    .nav {
      height: 56px;
      gap: 12px;
    }
    .mobile-panel {
      inset: 56px 0 0 0;
    }
    .brand-name {
      font-size: 13px;
      letter-spacing: 0.13em;
    }
    .brand-mark {
      width: 26px; height: 26px;
    }
  }

  /* ---------- REDUCED MOTION ---------- */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    html { scroll-behavior: auto; }
    .fade-up { opacity: 1; transform: none; }
  }

  /* ---------- PRINT ---------- */
  @media print {
    .site-header, .mobile-panel, #hero-canvas, .hero-actions, .nav-toggle,
    #chat-btn, #chat-panel { display: none; }
    section { padding: 24px 0; break-inside: avoid; }
    body { background: #fff; color: #000; }
  }
</style>
</head>
<body>

<!-- HEADER -->
<header class="site-header" id="site-header">
  <nav class="nav" id="primary-nav" aria-label="Primary">
    <a href="/" class="brand" aria-label="Kodek home">
