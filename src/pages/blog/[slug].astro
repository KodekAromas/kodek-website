---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const catColors: Record<string, string> = {
  'AI Research': 'oklch(65% 0.24 280)',
  'AR/VR': 'oklch(72% 0.16 198)',
  'Simulation': 'oklch(75% 0.18 160)',
  'Game Dev': 'oklch(72% 0.22 30)',
  'Architecture': 'oklch(72% 0.18 250)',
};
---

<Base title={`${post.data.title} — Kodek Blog`} description={post.data.description}>
<style>
  .post-page { padding: 140px 48px 100px; }
  .container { max-width: 760px; margin: 0 auto; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); text-decoration: none; font-size: 14px; font-weight: 500; margin-bottom: 48px; transition: color 0.2s; }
  .back-link:hover { color: var(--text); }
  .post-cat { font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 16px; }
  .post-title { font-family: 'Space Grotesk', sans-serif; font-size: clamp(28px, 4vw, 48px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px; }
  .post-meta { font-size: 13px; color: var(--text-muted); margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
  .post-body { font-size: 17px; color: var(--text-muted); line-height: 1.8; font-weight: 300; }
  .post-body h2 { font-family: 'Space Grotesk', sans-serif; font-size: 24px; font-weight: 700; color: var(--text); margin: 40px 0 16px; letter-spacing: -0.02em; }
  .post-body h3 { font-family: 'Space Grotesk', sans-serif; font-size: 19px; font-weight: 600; color: var(--text); margin: 32px 0 12px; }
  .post-body p { margin-bottom: 20px; }
  .post-body p:last-child { margin-bottom: 0; }
  .post-body strong { color: var(--text); font-weight: 500; }
  .post-body a { color: var(--accent2); text-decoration: underline; text-underline-offset: 3px; }
  .post-body ul, .post-body ol { padding-left: 24px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px; }
  .post-body li::marker { color: var(--accent); }
  .post-body code { font-family: monospace; font-size: 14px; background: var(--bg3); border: 1px solid var(--border); padding: 2px 7px; border-radius: 4px; color: var(--accent2); }
  .post-body pre { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 20px; overflow-x: auto; margin-bottom: 24px; }
  .post-body pre code { background: none; border: none; padding: 0; color: var(--text); font-size: 14px; }
  .post-body blockquote { border-left: 3px solid var(--accent); padding-left: 20px; margin: 24px 0; font-style: italic; }
  @media (max-width: 768px) { .post-page { padding: 120px 20px 64px; } }
</style>

<div class="post-page">
  <div class="container">
    <a href="/blog" class="back-link">← All articles</a>
    <div class="post-cat" style={`color:${catColors[post.data.category]}`}>{post.data.category}</div>
    <h1 class="post-title">{post.data.title}</h1>
    <div class="post-meta">
      {post.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
    </div>
    <div class="post-body">
      <Content />
    </div>
  </div>
</div>
</Base>
