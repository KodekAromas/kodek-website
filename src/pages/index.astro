---
import Base from '../layouts/Base.astro';
---

<Base>
<style>
  /* ---------- HERO ---------- */
  #hero {
    position: relative;
    padding-top: calc(var(--section-y) + 40px);
    padding-bottom: var(--section-y);
    min-height: clamp(560px, 88vh, 880px);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; isolation: isolate;
  }
  #hero::before {
    content: ''; position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 30%, oklch(66% 0.17 274 / 0.10), transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 100%, oklch(74% 0.10 220 / 0.06), transparent 70%);
  }
  #hero-canvas { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; opacity: 0.7; }
  .hero-content { position: relative; z-index: 2; text-align: center; max-width: 880px; padding-inline: var(--gutter); }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px; border: 1px solid var(--line-2); border-radius: 100px;
    font-size: 11.5px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-2); margin-bottom: clamp(20px, 3vw, 32px);
    background: rgba(255,255,255,0.02);
  }
  .hero-tag-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2s var(--ease) infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  .hero-h1 {
    font-size: clamp(36px, 6.4vw, 76px); font-weight: 600;
    line-height: 1.05; letter-spacing: -0.035em;
    margin-bottom: clamp(18px, 2.5vw, 28px);
  }
  .hero-h1 em { font-style: normal; color: var(--accent); }
  .hero-sub {
    font-size: clamp(15px, 1.6vw, 19px); color: var(--text-2);
    max-width: 620px; margin: 0 auto clamp(28px, 4vw, 44px); line-height: 1.65;
  }
  .hero-actions { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }

  /* ---------- STATS ---------- */
  .stats { background: var(--bg-1); border-block: 1px solid var(--line); padding: clamp(28px, 4vw, 40px) var(--gutter); }
  .stats-grid {
    max-width: var(--container); margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 3vw, 40px);
  }
  .stat { text-align: center; }
  .stat-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(26px, 3.5vw, 38px); font-weight: 700;
    color: var(--text); letter-spacing: -0.02em; line-height: 1;
  }
  .stat-num em { font-style: normal; color: var(--accent); }
  .stat-label { font-size: 12px; color: var(--text-3); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 8px; }

  /* ---------- VERTICALS ---------- */
  #verticals { background: var(--bg); }
  .verticals-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line);
    border-radius: var(--r-md); overflow: hidden;
  }
  .vertical-card {
    background: var(--bg); padding: clamp(24px, 3vw, 36px) clamp(20px, 2.5vw, 28px);
    display: flex; flex-direction: column; gap: 16px;
    transition: background var(--t-med) var(--ease); min-height: 220px;
  }
  .vertical-card:hover { background: var(--bg-2); }
  .vertical-icon {
    width: 40px; height: 40px; border-radius: var(--r-sm);
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent-soft); color: var(--accent); flex-shrink: 0;
  }
  .vertical-name { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 600; line-height: 1.3; }
  .vertical-desc { font-size: 13.5px; color: var(--text-2); line-height: 1.6; flex: 1; }
  .vertical-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .vtag {
    font-size: 11px; padding: 3px 10px; border: 1px solid var(--line-2);
    border-radius: 100px; color: var(--text-3); font-weight: 500; line-height: 1.5;
  }

  /* ---------- PRODUCTS ---------- */
  #products { background: var(--bg-1); }
  .products-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(20px, 3vw, 28px);
  }
  .product-card {
    border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: clamp(24px, 3vw, 40px); background: var(--bg);
    position: relative; overflow: hidden;
    transition: border-color var(--t-med) var(--ease);
    display: flex; flex-direction: column;
  }
  .product-card:hover { border-color: var(--line-2); }
  .product-badge {
    align-self: flex-start; padding: 4px 12px; border-radius: 100px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    margin-bottom: 20px; background: var(--accent-soft);
    color: var(--accent); border: 1px solid var(--accent-line);
  }
  .product-visual {
    aspect-ratio: 16/9; border-radius: var(--r-md); border: 1px solid var(--line);
    overflow: hidden; position: relative; background: var(--bg-3); margin-bottom: 16px;
  }
  .product-visual img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center;
    transition: opacity var(--t-med) var(--ease);
  }
  .product-visual::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(6,7,11,0.6), transparent 40%);
    pointer-events: none;
  }
  .visual-dots {
    position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 6px; z-index: 2;
  }
  .visual-dots button {
    width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.35); padding: 0;
    transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .visual-dots button.active { background: rgba(255,255,255,0.95); transform: scale(1.2); }
  .visual-tabs { display: flex; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
  .visual-tabs button {
    font-size: 11px; padding: 4px 10px; border: 1px solid var(--line); border-radius: 100px;
    color: var(--text-3); transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .visual-tabs button:hover { color: var(--text-2); border-color: var(--line-2); }
  .visual-tabs button.active { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .product-name { font-family: 'Space Grotesk', sans-serif; font-size: clamp(22px, 2.4vw, 26px); font-weight: 600; margin-bottom: 10px; }
  .product-desc { color: var(--text-2); font-size: 14.5px; line-height: 1.65; margin-bottom: 24px; }
  .product-features { list-style: none; display: flex; flex-direction: column; gap: 9px; margin-bottom: 28px; }
  .product-features li { display: flex; align-items: flex-start; gap: 10px; font-size: 13.5px; color: var(--text-2); line-height: 1.55; }
  .product-features li::before {
    content: ''; flex-shrink: 0; margin-top: 8px;
    width: 4px; height: 4px; border-radius: 50%; background: var(--accent);
  }

  /* ---------- SERVICES ---------- */
  #services { background: var(--bg); }
  .packages-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: clamp(12px, 2vw, 16px);
  }
  .pkg-card {
    border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: clamp(24px, 2.5vw, 32px); background: var(--bg);
    display: flex; flex-direction: column;
    transition: border-color var(--t-med) var(--ease), transform var(--t-med) var(--ease);
    position: relative;
  }
  .pkg-card:hover { border-color: var(--line-2); transform: translateY(-2px); }
  .pkg-card.featured {
    border-color: var(--accent-line);
    background: linear-gradient(180deg, var(--accent-soft), transparent 60%), var(--bg);
  }
  .pkg-card.featured::before {
    content: 'MOST POPULAR'; position: absolute; top: -10px; left: 24px;
    padding: 4px 10px; background: var(--accent); color: #fff;
    font-family: 'Space Grotesk', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.12em; border-radius: 100px;
  }
  .pkg-letter { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .pkg-name { font-family: 'Space Grotesk', sans-serif; font-size: 19px; font-weight: 600; margin-bottom: 8px; }
  .pkg-desc { font-size: 13.5px; color: var(--text-2); line-height: 1.55; margin-bottom: 22px; min-height: 3em; }
  .pkg-price { font-family: 'Space Grotesk', sans-serif; font-size: clamp(26px, 3vw, 32px); font-weight: 700; color: var(--text); line-height: 1; letter-spacing: -0.02em; }
  .pkg-price-sub { font-size: 12.5px; color: var(--text-3); margin: 6px 0 22px; }
  .pkg-timeline {
    font-size: 12px; color: var(--text-2); padding: 8px 12px;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--r-sm);
    margin-bottom: 22px; font-weight: 500;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .pkg-features { list-style: none; display: flex; flex-direction: column; gap: 9px; flex: 1; margin-bottom: 24px; }
  .pkg-features li { font-size: 13px; color: var(--text-2); display: flex; align-items: flex-start; gap: 8px; line-height: 1.5; }
  .pkg-features li::before {
    content: ''; flex-shrink: 0; margin-top: 6px;
    width: 14px; height: 8px;
    border-left: 1.5px solid var(--accent); border-bottom: 1.5px solid var(--accent);
    transform: rotate(-45deg) translate(2px, -2px);
  }
  .pkg-cta { width: 100%; }

  /* ---------- PORTFOLIO ---------- */
  #portfolio { background: var(--bg-1); }
  .portfolio-filter { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 40px); }
  .filter-btn {
    padding: 8px 16px; border: 1px solid var(--line); border-radius: 100px;
    color: var(--text-2); font-size: 13px;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .filter-btn:hover { color: var(--text); border-color: var(--line-2); }
  .filter-btn.active { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .portfolio-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(16px, 2.5vw, 24px);
  }
  .portfolio-card {
    border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden;
    background: var(--bg); transition: border-color var(--t-med) var(--ease), transform var(--t-med) var(--ease);
    cursor: pointer; display: flex; flex-direction: column;
  }
  .portfolio-card:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .portfolio-thumb {
    aspect-ratio: 16/10; background: var(--bg-3);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .portfolio-thumb-label { font-family: 'Space Grotesk', sans-serif; font-size: 11px; color: var(--text-3); letter-spacing: 0.08em; text-align: center; text-transform: uppercase; }
  .portfolio-info { padding: 20px 22px; }
  .portfolio-cat { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px; color: var(--accent); }
  .portfolio-title { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .portfolio-desc { font-size: 13px; color: var(--text-2); line-height: 1.55; }

  /* ---------- ABOUT ---------- */
  #about { background: var(--bg); }
  .about-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .about-body { font-size: clamp(15px, 1.3vw, 16.5px); color: var(--text-2); line-height: 1.75; }
  .about-body p + p { margin-top: 18px; }
  .about-body strong { color: var(--text); font-weight: 500; }
  .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
  .value-card { padding: 20px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg-1); }
  .value-title { font-family: 'Space Grotesk', sans-serif; font-size: 14px; font-weight: 600; margin-bottom: 6px; color: var(--text); }
  .value-desc { font-size: 13px; color: var(--text-2); line-height: 1.55; }
  .team-card { margin-top: 28px; padding: clamp(20px, 2.5vw, 28px); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg-1); }
  .team-card .team-text { font-size: 14.5px; color: var(--text-2); line-height: 1.7; }
  .team-card .team-text strong { color: var(--text); font-weight: 500; }
  .team-tags { margin-top: 18px; display: flex; gap: 8px; flex-wrap: wrap; }

  /* ---------- BLOG ---------- */
  #blog { background: var(--bg-1); }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: clamp(16px, 2.5vw, 22px); }
  .blog-card {
    border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; background: var(--bg);
    transition: border-color var(--t-med) var(--ease), transform var(--t-med) var(--ease);
    cursor: pointer; display: flex; flex-direction: column; text-decoration: none; color: inherit;
  }
  .blog-card:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .blog-thumb { aspect-ratio: 16/9; background: linear-gradient(135deg, var(--bg-2), var(--bg-3)); display: flex; align-items: center; justify-content: center; }
  .blog-thumb-label { font-family: 'Space Grotesk', sans-serif; font-size: 10.5px; color: var(--text-3); letter-spacing: 0.08em; text-transform: uppercase; }
  .blog-info { padding: 22px 24px; flex: 1; display: flex; flex-direction: column; }
  .blog-cat { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .blog-title { font-family: 'Space Grotesk', sans-serif; font-size: 16.5px; font-weight: 600; margin-bottom: 10px; line-height: 1.35; }
  .blog-excerpt { font-size: 13px; color: var(--text-2); line-height: 1.6; margin-bottom: 16px; }
  .blog-meta { margin-top: auto; font-size: 11.5px; color: var(--text-3); letter-spacing: 0.06em; text-transform: uppercase; }

  /* ---------- CAREERS ---------- */
  #careers { background: var(--bg); }
  .roles-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(14px, 2vw, 18px); margin-bottom: clamp(32px, 4vw, 48px);
  }
  .role-card {
    border: 1px solid var(--line); border-radius: var(--r-md);
    padding: clamp(22px, 2.5vw, 30px); background: var(--bg-1);
    display: flex; flex-direction: column; gap: 14px;
    transition: border-color var(--t-med) var(--ease);
  }
  .role-card:hover { border-color: var(--line-2); }
  .role-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .role-name { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 600; }
  .role-status {
    font-size: 11px; padding: 3px 10px; border-radius: 100px;
    background: oklch(75% 0.13 160 / 0.12); color: oklch(75% 0.13 160);
    font-weight: 600; letter-spacing: 0.08em;
  }
  .role-desc { font-size: 13.5px; color: var(--text-2); line-height: 1.6; }
  .role-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .role-apply { margin-top: 6px; font-size: 13px; font-weight: 600; color: var(--accent); text-decoration: none; font-family: 'Space Grotesk', sans-serif; }
  .role-apply:hover { text-decoration: underline; }
  .careers-cta {
    padding: clamp(24px, 3vw, 32px) clamp(24px, 3vw, 40px);
    border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg-1);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;
  }
  .careers-cta-title { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 600; margin-bottom: 6px; }
  .careers-cta-text { font-size: 13.5px; color: var(--text-2); }

  /* ---------- CONTACT ---------- */
  #contact { background: var(--bg-1); }
  .contact-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .contact-details { display: flex; flex-direction: column; gap: 24px; margin-top: 28px; }
  .contact-item-label { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); margin-bottom: 4px; }
  .contact-item-val { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 500; color: var(--text); }
  .contact-form { display: flex; flex-direction: column; gap: 14px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 12.5px; font-weight: 500; color: var(--text-2); letter-spacing: 0.02em; }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-sm);
    padding: 12px 14px; font-size: 14.5px; color: var(--text); outline: none;
    transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
    -webkit-appearance: none;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    border-color: var(--accent-line); background: var(--bg-2);
  }
  .form-group select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%237d7c8a' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat; background-position: right 14px center; padding-right: 36px;
    background-color: var(--bg);
  }
  .form-group textarea { resize: vertical; min-height: 120px; }
  .form-group input::placeholder, .form-group textarea::placeholder { color: var(--text-3); opacity: 0.7; }
  #form-success {
    display: none; padding: 22px; border: 1px solid var(--accent-line);
    border-radius: var(--r-md); background: var(--accent-soft); margin-top: 16px;
  }
  .form-success-title { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600; color: var(--accent); margin-bottom: 4px; }
  .form-success-text { font-size: 13.5px; color: var(--text-2); }

  /* ---------- BREAKPOINTS ---------- */
  @media (max-width: 1024px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); row-gap: 28px; }
  }
  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .careers-cta { flex-direction: column; align-items: stretch; }
    .careers-cta .btn { width: 100%; }
    .hero-actions .btn { flex: 1 1 160px; }
  }
  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<!-- HERO -->
<section id="hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <div class="hero-tag">
      <span class="hero-tag-dot"></span>
      AI &amp; Technology Research Company
    </div>
    <h1 class="hero-h1">
      We build <em>AI.</em><br>
      We build <em>simulations.</em><br>
      We build <em>worlds.</em>
    </h1>
    <p class="hero-sub">
      Kodek creates intelligent software, immersive AR/VR experiences, physics-based simulations, and interactive games — for industries that demand more from technology.
    </p>
    <div class="hero-actions">
      <a href="#portfolio" class="btn btn-primary btn-lg">See our work</a>
      <a href="#contact" class="btn btn-ghost btn-lg">Start a project</a>
    </div>
  </div>
</section>

<!-- STATS -->
<div class="stats">
  <div class="stats-grid">
    <div class="stat">
      <div class="stat-num">5</div>
      <div class="stat-label">Technology Verticals</div>
    </div>
    <div class="stat">
      <div class="stat-num">100<em>%</em></div>
      <div class="stat-label">Research-Grade Depth</div>
    </div>
    <div class="stat">
      <div class="stat-num">2</div>
      <div class="stat-label">Live Products</div>
    </div>
    <div class="stat">
      <div class="stat-num">30<em>d</em></div>
      <div class="stat-label">MVP Delivery</div>
    </div>
  </div>
</div>

<!-- VERTICALS -->
<section id="verticals">
  <div class="container">
    <div class="section-header fade-up">
      <span class="eyebrow">Five technology domains</span>
      <div class="geo-line"></div>
      <h2 class="section-title">One company. Infinite applications.</h2>
      <p class="section-sub">We are not a software agency. We are an AI and technology research company — unified by one capability: intelligent, interactive, and immersive systems.</p>
    </div>
    <div class="verticals-grid fade-up">
