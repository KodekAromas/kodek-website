  try{const res=await fetch('https://formsubmit.co/ajax/sales@kodek.in',{method:'POST',body:new FormData(form),headers:{'Accept':'application/json'}});const json=await res.json();if(json.success==='true'||json.success===true||res.ok){document.getElementById('form-success').style.display='block';form.style.display='none';}else{btn.textContent='Failed — try again';btn.disabled=false;}}catch{btn.textContent='Failed — try again';btn.disabled=false;}
}
