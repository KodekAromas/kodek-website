<!-- CONTACT -->
<section id="contact">
  <div class="container">
    <div class="contact-grid">
      <div class="fade-up">
        <span class="eyebrow">Start a project</span>
        <div class="geo-line"></div>
        <h2 class="section-title">Let's build something you've never seen before.</h2>
        <div class="contact-details">
          <div>
            <div class="contact-item-label">Website</div>
            <div class="contact-item-val">kodek.in</div>
          </div>
          <div>
            <div class="contact-item-label">Email</div>
            <div class="contact-item-val">sales@kodek.in</div>
          </div>
          <div>
            <div class="contact-item-label">Location</div>
            <div class="contact-item-val">Bhubaneswar, Odisha, India</div>
          </div>
          <div>
            <div class="contact-item-label">Company</div>
            <div class="contact-item-val">Kodekaromas Technologies Pvt. Ltd.</div>
          </div>
          <div>
            <div class="contact-item-label">Response time</div>
            <div class="contact-item-val">Within 24 hours</div>
          </div>
        </div>
      </div>
      <div class="fade-up">
        <form class="contact-form" id="contact-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="f-name">Name</label>
              <input id="f-name" type="text" name="name" placeholder="Your name" autocomplete="name" required>
            </div>
            <div class="form-group">
              <label for="f-email">Email</label>
              <input id="f-email" type="email" name="email" placeholder="you@company.com" autocomplete="email" required>
            </div>
          </div>
          <div class="form-group">
            <label for="f-company">Company / Project</label>
            <input id="f-company" type="text" name="company" placeholder="Company or project name" autocomplete="organization">
          </div>
          <div class="form-group">
            <label for="f-vertical">What do you want to build?</label>
            <select id="f-vertical" name="vertical">
              <option value="">Select a vertical…</option>
              <option>AI Research &amp; Software</option>
              <option>Software Simulations</option>
              <option>AR / VR Experience</option>
              <option>Game Development</option>
              <option>Architecture &amp; Built Environment</option>
              <option>Not sure — let's talk</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-message">Tell us about your project</label>
            <textarea id="f-message" name="message" placeholder="What problem are you solving? What does success look like?"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg" id="form-submit" style="align-self:flex-start;">Send message →</button>
        </form>
        <div id="form-success">
          <div class="form-success-title">Message sent.</div>
          <div class="form-success-text">We'll get back to you within 24 hours.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  // ---- HERO PARTICLE NETWORK ----
  var canvas = document.getElementById('hero-canvas');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var ctx = canvas.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0, H = 0, nodes = [], mouse = { x: -9999, y: -9999 };
    var isMobile = window.matchMedia('(max-width: 600px)').matches;
    var COUNT = isMobile ? 36 : 70;
    var MAX_DIST = isMobile ? 110 : 150;
    var raf = null;

    function resize() {
      var rect = canvas.getBoundingClientRect();
      W = rect.width; H = rect.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function build() {
      nodes = [];
      for (var i = 0; i < COUNT; i++) {
        nodes.push({ x: Math.random()*W, y: Math.random()*H, vx: (Math.random()-0.5)*0.35, vy: (Math.random()-0.5)*0.35, r: Math.random()*1.4+0.6 });
      }
    }
    resize(); build();
    window.addEventListener('resize', function () {
      var wasMobile = isMobile;
      isMobile = window.matchMedia('(max-width: 600px)').matches;
      resize();
      if (wasMobile !== isMobile) { COUNT = isMobile ? 36 : 70; MAX_DIST = isMobile ? 110 : 150; build(); }
    });
    canvas.addEventListener('mousemove', function (e) { var r = canvas.getBoundingClientRect(); mouse.x = e.clientX-r.left; mouse.y = e.clientY-r.top; });
    canvas.addEventListener('mouseleave', function () { mouse.x = -9999; mouse.y = -9999; });
    canvas.addEventListener('touchmove', function (e) { var r = canvas.getBoundingClientRect(), t = e.touches[0]; mouse.x = t.clientX-r.left; mouse.y = t.clientY-r.top; }, { passive: true });
    canvas.addEventListener('touchend', function () { mouse.x = -9999; mouse.y = -9999; });

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i]; n.x += n.vx; n.y += n.vy;
        if (n.x < 0 || n.x > W) n.vx *= -1;
        if (n.y < 0 || n.y > H) n.vy *= -1;
        var dx = n.x-mouse.x, dy = n.y-mouse.y, dm = Math.sqrt(dx*dx+dy*dy);
        if (dm < 80) {
          var f = (80-dm)/80*0.4; n.vx += dx/dm*f; n.vy += dy/dm*f;
          if (Math.abs(n.vx) > 1.2) n.vx *= 0.8;
          if (Math.abs(n.vy) > 1.2) n.vy *= 0.8;
        }
        for (var j = i+1; j < nodes.length; j++) {
          var m = nodes[j], ex = m.x-n.x, ey = m.y-n.y, d = Math.sqrt(ex*ex+ey*ey);
          if (d < MAX_DIST) {
            var t = 1-d/MAX_DIST;
            ctx.beginPath(); ctx.moveTo(n.x, n.y); ctx.lineTo(m.x, m.y);
            ctx.strokeStyle = 'rgba(140,130,220,'+(t*0.18)+')';
            ctx.lineWidth = t*0.9; ctx.stroke();
          }
        }
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(180,170,230,0.55)'; ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    }

    if ('IntersectionObserver' in window) {
      var hio = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) { if (!raf) draw(); }
          else { if (raf) { cancelAnimationFrame(raf); raf = null; } }
        });
      });
      hio.observe(document.getElementById('hero'));
    } else { draw(); }
  }

  // ---- PORTFOLIO FILTER ----
  var filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cat = btn.getAttribute('data-filter');
      filterBtns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelectorAll('.portfolio-card').forEach(function (card) {
        card.style.display = (cat === 'all' || card.getAttribute('data-cat') === cat) ? '' : 'none';
      });
    });
  });

  // ---- PRODUCT CAROUSELS ----
  var bcImages = [
    '/uploads/pasted-1777572026269-0.png',
    '/uploads/pasted-1777571880300-0.png',
    '/uploads/pasted-1777571946926-0.png',
    '/uploads/pasted-1777571968172-0.png'
  ];
  var rrImages = [
    '/uploads/pasted-1777572201227-0.png',
    '/uploads/pasted-1777572244092-0.png',
    '/uploads/pasted-1777572256838-0.png'
  ];

  function makeCarousel(opts) {
    var img = document.getElementById(opts.imgId);
    var dots = document.querySelectorAll(opts.dotSel);
    var tabs = document.querySelectorAll(opts.tabSel);
    if (!img || !dots.length) return;
    var current = 0, timer = null;

    function set(idx) {
      current = idx;
      img.style.opacity = '0';
      setTimeout(function () { img.src = opts.images[idx]; img.style.opacity = '1'; }, 180);
      dots.forEach(function (d, i) { d.classList.toggle('active', i === idx); });
      tabs.forEach(function (t) { t.classList.toggle('active', parseInt(t.getAttribute(opts.attr), 10) === idx); });
    }
    function start() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop(); timer = setInterval(function () { set((current+1) % opts.images.length); }, opts.interval || 3500);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    dots.forEach(function (d) {
      d.addEventListener('click', function () { set(parseInt(d.getAttribute(opts.attr), 10)); start(); });
    });
    tabs.forEach(function (t) {
      t.addEventListener('click', function () { set(parseInt(t.getAttribute(opts.attr), 10)); start(); });
    });

    var visual = document.getElementById(opts.visualId);
    if ('IntersectionObserver' in window && visual) {
      var vio = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) start(); else stop(); });
      });
      vio.observe(visual);
    } else { start(); }
  }

  makeCarousel({ imgId:'bc-img', visualId:'bc-visual', dotSel:'.bc-dot', tabSel:'.bc-tab', attr:'data-bc', interval:3000, images:bcImages });
  makeCarousel({ imgId:'rr-img', visualId:'rr-visual', dotSel:'.rr-dot', tabSel:'.rr-tab', attr:'data-rr', interval:3500, images:rrImages });

  // ---- CONTACT FORM ----
  var form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      var btn = document.getElementById('form-submit');
      var orig = btn.textContent;
      btn.textContent = 'Sending…'; btn.disabled = true;
      var payload = {
        name:     document.getElementById('f-name')?.value?.trim() ?? '',
        email:    document.getElementById('f-email')?.value?.trim() ?? '',
        company:  document.getElementById('f-company')?.value?.trim() ?? '',
        vertical: document.getElementById('f-vertical')?.value ?? '',
        message:  document.getElementById('f-message')?.value?.trim() ?? '',
      };
      try {
        var res = await fetch('/api/contact', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var json = await res.json();
        if (res.ok && json.success) {
          document.getElementById('form-success').style.display = 'block';
          form.style.display = 'none';
        } else {
          btn.textContent = 'Failed — try again'; btn.disabled = false;
        }
      } catch {
        btn.textContent = orig; btn.disabled = false;
      }
    });
  }
})();
</script>
</Base>
