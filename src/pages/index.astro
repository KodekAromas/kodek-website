<script>
// ---- HERO CANVAS ----
(function() {
  const canvas = document.getElementById('hero-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, nodes = [], mouse = { x: -999, y: -999 };
  function resize() { W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }
  window.addEventListener('resize', resize); resize();
  const NODE_COUNT = 80, MAX_DIST = 140;
  function makeNode() { return { x: Math.random()*W, y: Math.random()*H, vx: (Math.random()-0.5)*0.4, vy: (Math.random()-0.5)*0.4, r: Math.random()*1.8+0.8 }; }
  for (let i = 0; i < NODE_COUNT; i++) nodes.push(makeNode());
  canvas.addEventListener('mousemove', e => { const r = canvas.getBoundingClientRect(); mouse.x = e.clientX-r.left; mouse.y = e.clientY-r.top; });
  canvas.addEventListener('mouseleave', () => { mouse.x = -999; mouse.y = -999; });
  const c1=[124,106,240], c2=[76,201,224];
  function lerp(a,b,t){return a+(b-a)*t;}
  function draw() {
    ctx.clearRect(0,0,W,H);
    for (let i=0;i<nodes.length;i++) {
      const n=nodes[i]; n.x+=n.vx; n.y+=n.vy;
      if(n.x<0||n.x>W) n.vx*=-1; if(n.y<0||n.y>H) n.vy*=-1;
      const dx=n.x-mouse.x,dy=n.y-mouse.y,dm=Math.sqrt(dx*dx+dy*dy);
      if(dm<80&&dm>0){const f=(80-dm)/80*0.5;n.vx+=dx/dm*f;n.vy+=dy/dm*f;const sp=Math.sqrt(n.vx*n.vx+n.vy*n.vy);if(sp>2){n.vx=n.vx/sp*2;n.vy=n.vy/sp*2;}}
      for (let j=i+1;j<nodes.length;j++) {
        const m=nodes[j],ex=m.x-n.x,ey=m.y-n.y,d=Math.sqrt(ex*ex+ey*ey);
        if(d<MAX_DIST){const t=1-d/MAX_DIST,mid=i/nodes.length;ctx.beginPath();ctx.moveTo(n.x,n.y);ctx.lineTo(m.x,m.y);ctx.strokeStyle=`rgba(${Math.round(lerp(c1[0],c2[0],mid))},${Math.round(lerp(c1[1],c2[1],mid))},${Math.round(lerp(c1[2],c2[2],mid))},${t*0.25})`;ctx.lineWidth=t*1.2;ctx.stroke();}
      }
      const frac=i/nodes.length;ctx.beginPath();ctx.arc(n.x,n.y,n.r,0,Math.PI*2);ctx.fillStyle=`rgba(${Math.round(lerp(c1[0],c2[0],frac))},${Math.round(lerp(c1[1],c2[1],frac))},${Math.round(lerp(c1[2],c2[2],frac))},0.7)`;ctx.fill();
    }
    requestAnimationFrame(draw);
  }
  draw();
})();

